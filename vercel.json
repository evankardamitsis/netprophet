{
  "buildCommand": "pnpm install --frozen-lockfile && pnpm run build",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/match-automation",
      "schedule": "*/2 8-23 * * *"
    },
    {
      "path": "/api/cron/mailerlite/weekly",
      "schedule": "0 17 * * 0"
    },
    {
      "path": "/api/cron/mailerlite/inactivity",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/mailerlite/match-alert-monday",
      "schedule": "50 6 * * 1"
    },
    {
      "path": "/api/cron/mailerlite/match-alert-thursday",
      "schedule": "50 6 * * 4"
    }
  ]
}
