{
  "name": "@netprophet/db",
  "version": "0.0.0",
  "private": true,
  "description": "Generated types for the v2 api schema (views + RPCs) and a typed Supabase client factory.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "sideEffects": false,
  "scripts": {
    "gen-types": "node scripts/gen-types.mjs --out src/types.ts",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.57.1",
    "typescript": "^5.3.0",
    "vitest": "^1.6.0"
  }
}
