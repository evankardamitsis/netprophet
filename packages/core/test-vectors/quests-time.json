{
  "suite": "quests-time",
  "version": 1,
  "notes": "Europe/Athens boundaries incl. DST (2026-03-29 forward, 2026-10-25 back). Daily and monthly keys are dates; weekly key is the Monday date.",
  "groups": [
    {
      "fn": "windowKey",
      "cases": [
        {
          "name": "daily key at 2026-10-09T10:00:00Z",
          "input": {
            "window": "daily",
            "at": "2026-10-09T10:00:00Z"
          },
          "expected": "2026-10-09"
        },
        {
          "name": "daily key at 2026-10-09T20:59:59Z",
          "input": {
            "window": "daily",
            "at": "2026-10-09T20:59:59Z"
          },
          "expected": "2026-10-09"
        },
        {
          "name": "daily key at 2026-10-09T21:00:00Z",
          "input": {
            "window": "daily",
            "at": "2026-10-09T21:00:00Z"
          },
          "expected": "2026-10-10"
        },
        {
          "name": "daily key at 2026-12-01T21:59:59Z",
          "input": {
            "window": "daily",
            "at": "2026-12-01T21:59:59Z"
          },
          "expected": "2026-12-01"
        },
        {
          "name": "daily key at 2026-12-01T22:00:00Z",
          "input": {
            "window": "daily",
            "at": "2026-12-01T22:00:00Z"
          },
          "expected": "2026-12-02"
        },
        {
          "name": "daily key at 2026-03-28T21:59:59Z",
          "input": {
            "window": "daily",
            "at": "2026-03-28T21:59:59Z"
          },
          "expected": "2026-03-28"
        },
        {
          "name": "daily key at 2026-03-28T22:00:00Z",
          "input": {
            "window": "daily",
            "at": "2026-03-28T22:00:00Z"
          },
          "expected": "2026-03-29"
        },
        {
          "name": "daily key at 2026-03-29T20:59:59Z",
          "input": {
            "window": "daily",
            "at": "2026-03-29T20:59:59Z"
          },
          "expected": "2026-03-29"
        },
        {
          "name": "daily key at 2026-03-29T21:00:00Z",
          "input": {
            "window": "daily",
            "at": "2026-03-29T21:00:00Z"
          },
          "expected": "2026-03-30"
        },
        {
          "name": "daily key at 2026-10-25T00:59:59Z",
          "input": {
            "window": "daily",
            "at": "2026-10-25T00:59:59Z"
          },
          "expected": "2026-10-25"
        },
        {
          "name": "daily key at 2026-10-25T21:59:59Z",
          "input": {
            "window": "daily",
            "at": "2026-10-25T21:59:59Z"
          },
          "expected": "2026-10-25"
        },
        {
          "name": "daily key at 2026-10-25T22:00:00Z",
          "input": {
            "window": "daily",
            "at": "2026-10-25T22:00:00Z"
          },
          "expected": "2026-10-26"
        },
        {
          "name": "daily key at 2026-12-31T22:00:00Z",
          "input": {
            "window": "daily",
            "at": "2026-12-31T22:00:00Z"
          },
          "expected": "2027-01-01"
        },
        {
          "name": "weekly key at 2026-10-09T10:00:00Z",
          "input": {
            "window": "weekly",
            "at": "2026-10-09T10:00:00Z"
          },
          "expected": "2026-10-05"
        },
        {
          "name": "weekly key at 2026-10-11T20:59:59Z",
          "input": {
            "window": "weekly",
            "at": "2026-10-11T20:59:59Z"
          },
          "expected": "2026-10-05"
        },
        {
          "name": "weekly key at 2026-10-11T21:00:00Z",
          "input": {
            "window": "weekly",
            "at": "2026-10-11T21:00:00Z"
          },
          "expected": "2026-10-12"
        },
        {
          "name": "weekly key at 2026-03-29T12:00:00Z",
          "input": {
            "window": "weekly",
            "at": "2026-03-29T12:00:00Z"
          },
          "expected": "2026-03-23"
        },
        {
          "name": "weekly key at 2026-03-29T21:00:00Z",
          "input": {
            "window": "weekly",
            "at": "2026-03-29T21:00:00Z"
          },
          "expected": "2026-03-30"
        },
        {
          "name": "weekly key at 2026-10-25T12:00:00Z",
          "input": {
            "window": "weekly",
            "at": "2026-10-25T12:00:00Z"
          },
          "expected": "2026-10-19"
        },
        {
          "name": "weekly key at 2026-10-25T22:00:00Z",
          "input": {
            "window": "weekly",
            "at": "2026-10-25T22:00:00Z"
          },
          "expected": "2026-10-26"
        },
        {
          "name": "weekly key at 2026-11-29T21:59:59Z",
          "input": {
            "window": "weekly",
            "at": "2026-11-29T21:59:59Z"
          },
          "expected": "2026-11-23"
        },
        {
          "name": "weekly key at 2026-11-29T22:00:00Z",
          "input": {
            "window": "weekly",
            "at": "2026-11-29T22:00:00Z"
          },
          "expected": "2026-11-30"
        },
        {
          "name": "weekly key at 2026-12-31T22:00:00Z",
          "input": {
            "window": "weekly",
            "at": "2026-12-31T22:00:00Z"
          },
          "expected": "2026-12-28"
        },
        {
          "name": "lifetime key at 2026-10-09T10:00:00Z",
          "input": {
            "window": "lifetime",
            "at": "2026-10-09T10:00:00Z"
          },
          "expected": "all"
        }
      ]
    },
    {
      "fn": "monthKey",
      "cases": [
        {
          "name": "before the 1st in summer time",
          "input": "2026-09-30T20:59:59Z",
          "expected": "2026-09"
        },
        {
          "name": "Oct 1 00:00 EEST",
          "input": "2026-09-30T21:00:00Z",
          "expected": "2026-10"
        },
        {
          "name": "Oct 31 23:59:59 EET",
          "input": "2026-10-31T21:59:59Z",
          "expected": "2026-10"
        },
        {
          "name": "Nov 1 00:00 EET",
          "input": "2026-10-31T22:00:00Z",
          "expected": "2026-11"
        },
        {
          "name": "Dec 31 23:59:59 EET",
          "input": "2026-12-31T21:59:59Z",
          "expected": "2026-12"
        },
        {
          "name": "Jan 1 00:00 EET",
          "input": "2026-12-31T22:00:00Z",
          "expected": "2027-01"
        }
      ]
    },
    {
      "fn": "nextReset",
      "cases": [
        {
          "name": "next daily reset after 2026-10-09T10:00:00Z",
          "input": {
            "window": "daily",
            "at": "2026-10-09T10:00:00Z"
          },
          "expected": "2026-10-09T21:00:00.000Z"
        },
        {
          "name": "next daily reset after 2026-10-09T21:00:00Z",
          "input": {
            "window": "daily",
            "at": "2026-10-09T21:00:00Z"
          },
          "expected": "2026-10-10T21:00:00.000Z"
        },
        {
          "name": "next daily reset after 2026-12-01T12:00:00Z",
          "input": {
            "window": "daily",
            "at": "2026-12-01T12:00:00Z"
          },
          "expected": "2026-12-01T22:00:00.000Z"
        },
        {
          "name": "next daily reset after 2026-03-29T10:00:00Z",
          "input": {
            "window": "daily",
            "at": "2026-03-29T10:00:00Z"
          },
          "expected": "2026-03-29T21:00:00.000Z"
        },
        {
          "name": "next daily reset after 2026-10-25T10:00:00Z",
          "input": {
            "window": "daily",
            "at": "2026-10-25T10:00:00Z"
          },
          "expected": "2026-10-25T22:00:00.000Z"
        },
        {
          "name": "next weekly reset after 2026-10-09T10:00:00Z",
          "input": {
            "window": "weekly",
            "at": "2026-10-09T10:00:00Z"
          },
          "expected": "2026-10-11T21:00:00.000Z"
        },
        {
          "name": "next weekly reset after 2026-03-29T12:00:00Z",
          "input": {
            "window": "weekly",
            "at": "2026-03-29T12:00:00Z"
          },
          "expected": "2026-03-29T21:00:00.000Z"
        },
        {
          "name": "next weekly reset after 2026-10-25T12:00:00Z",
          "input": {
            "window": "weekly",
            "at": "2026-10-25T12:00:00Z"
          },
          "expected": "2026-10-25T22:00:00.000Z"
        },
        {
          "name": "next monthly reset after 2026-09-15T00:00:00Z",
          "input": {
            "window": "monthly",
            "at": "2026-09-15T00:00:00Z"
          },
          "expected": "2026-09-30T21:00:00.000Z"
        },
        {
          "name": "next monthly reset after 2026-10-15T00:00:00Z",
          "input": {
            "window": "monthly",
            "at": "2026-10-15T00:00:00Z"
          },
          "expected": "2026-10-31T22:00:00.000Z"
        },
        {
          "name": "next monthly reset after 2026-12-15T00:00:00Z",
          "input": {
            "window": "monthly",
            "at": "2026-12-15T00:00:00Z"
          },
          "expected": "2026-12-31T22:00:00.000Z"
        }
      ]
    },
    {
      "fn": "daysLeftInMonth",
      "cases": [
        {
          "name": "last day",
          "input": "2026-10-31T21:59:59Z",
          "expected": 1
        },
        {
          "name": "first day of November",
          "input": "2026-10-31T22:00:00Z",
          "expected": 30
        },
        {
          "name": "mid October",
          "input": "2026-10-09T10:00:00Z",
          "expected": 23
        },
        {
          "name": "leap February",
          "input": "2028-02-28T10:00:00Z",
          "expected": 2
        }
      ]
    }
  ]
}
