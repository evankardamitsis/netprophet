{
  "suite": "game-level",
  "version": 1,
  "notes": "The game level from total points: triangular on a step (100). gameLevel gives level, into, span, next; gameLevelStart the total where a level starts. core.game_level (SQL) runs gameLevel.",
  "groups": [
    {
      "fn": "gameLevel",
      "cases": [
        {
          "name": "nothing yet",
          "input": {
            "points": 0
          },
          "expected": {
            "level": 1,
            "into": 0,
            "span": 100,
            "next": 100
          }
        },
        {
          "name": "below zero counts as zero",
          "input": {
            "points": -20
          },
          "expected": {
            "level": 1,
            "into": 0,
            "span": 100,
            "next": 100
          }
        },
        {
          "name": "one short of level 2",
          "input": {
            "points": 99
          },
          "expected": {
            "level": 1,
            "into": 99,
            "span": 100,
            "next": 1
          }
        },
        {
          "name": "level 2 at 100",
          "input": {
            "points": 100
          },
          "expected": {
            "level": 2,
            "into": 0,
            "span": 200,
            "next": 200
          }
        },
        {
          "name": "one short of level 3",
          "input": {
            "points": 299
          },
          "expected": {
            "level": 2,
            "into": 199,
            "span": 200,
            "next": 1
          }
        },
        {
          "name": "level 3 at 300",
          "input": {
            "points": 300
          },
          "expected": {
            "level": 3,
            "into": 0,
            "span": 300,
            "next": 300
          }
        },
        {
          "name": "340 is level 3",
          "input": {
            "points": 340
          },
          "expected": {
            "level": 3,
            "into": 40,
            "span": 300,
            "next": 260
          }
        },
        {
          "name": "level 4 at 600",
          "input": {
            "points": 600
          },
          "expected": {
            "level": 4,
            "into": 0,
            "span": 400,
            "next": 400
          }
        },
        {
          "name": "level 5 at 1000",
          "input": {
            "points": 1000
          },
          "expected": {
            "level": 5,
            "into": 0,
            "span": 500,
            "next": 500
          }
        },
        {
          "name": "one short of level 10",
          "input": {
            "points": 4499
          },
          "expected": {
            "level": 9,
            "into": 899,
            "span": 900,
            "next": 1
          }
        },
        {
          "name": "level 10 at 4500",
          "input": {
            "points": 4500
          },
          "expected": {
            "level": 10,
            "into": 0,
            "span": 1000,
            "next": 1000
          }
        },
        {
          "name": "no cap",
          "input": {
            "points": 123456
          },
          "expected": {
            "level": 50,
            "into": 956,
            "span": 5000,
            "next": 4044
          }
        },
        {
          "name": "step 50: level 2 at 50",
          "input": {
            "points": 50,
            "step": 50
          },
          "expected": {
            "level": 2,
            "into": 0,
            "span": 100,
            "next": 100
          }
        },
        {
          "name": "step 50: one short of level 3",
          "input": {
            "points": 149,
            "step": 50
          },
          "expected": {
            "level": 2,
            "into": 99,
            "span": 100,
            "next": 1
          }
        },
        {
          "name": "step 50: level 3 at 150",
          "input": {
            "points": 150,
            "step": 50
          },
          "expected": {
            "level": 3,
            "into": 0,
            "span": 150,
            "next": 150
          }
        }
      ]
    },
    {
      "fn": "gameLevelStart",
      "cases": [
        {
          "name": "level 1 starts at 0",
          "input": {
            "level": 1
          },
          "expected": 0
        },
        {
          "name": "level 2 starts at 100",
          "input": {
            "level": 2
          },
          "expected": 100
        },
        {
          "name": "level 3 starts at 300",
          "input": {
            "level": 3
          },
          "expected": 300
        },
        {
          "name": "level 4 starts at 600",
          "input": {
            "level": 4
          },
          "expected": 600
        },
        {
          "name": "level 5 starts at 1000",
          "input": {
            "level": 5
          },
          "expected": 1000
        },
        {
          "name": "level 10 starts at 4500",
          "input": {
            "level": 10
          },
          "expected": 4500
        }
      ]
    }
  ]
}
