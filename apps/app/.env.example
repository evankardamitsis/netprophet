# Public values only. Without them the app runs on mock data.
# Local stack: scripts/v2-db-remote.sh start prints API_URL and PUBLISHABLE_KEY.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# PostHog Cloud EU project key (public, ships in the app); sends only from release builds
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# set to 1 to send from a development build while checking an event
EXPO_PUBLIC_POSTHOG_DEV=
# dev only: «Άλλη φορά» enters without an account on sample data (off unless 1)
EXPO_PUBLIC_DEV_GUEST=
# Payments through RevenueCat (public SDK keys, safe in the app; the founder sets them)
EXPO_PUBLIC_RC_WEB_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=
EXPO_PUBLIC_RC_IOS_KEY=
