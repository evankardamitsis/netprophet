{
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile --filter @netprophet/app...",
  "buildCommand": "cd ../.. && pnpm --filter @netprophet/app exec expo export -p web",
  "outputDirectory": "dist",
  "framework": null,
  "ignoreCommand": "cd ../.. && npx turbo-ignore @netprophet/app --fallback=HEAD^",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/_expo/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
