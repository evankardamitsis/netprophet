{
  "expo": {
    "name": "NetProphet",
    "slug": "netprophet",
    "scheme": "netprophet",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3F5EE",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "gr.monadlabs.netprophet",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "gr.monadlabs.netprophet",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-image",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F2019",
          "image": "./assets/splash-logo.png",
          "imageWidth": 246.67
        }
      ],
      "expo-sharing",
      "expo-apple-authentication",
      "./plugins/withSceneLifecycle"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7136d3b3-4932-48d5-a8f6-64b527e13d2a"
      }
    },
    "owner": "evankardamitsis"
  }
}
