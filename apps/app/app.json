{
  "expo": {
    "name": "NetProphet",
    "slug": "netprophet",
    "scheme": "netprophet",
    "version": "1.0.2",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3F5EE",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/7136d3b3-4932-48d5-a8f6-64b527e13d2a",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "bundleIdentifier": "gr.monadlabs.netprophet",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleLocalizations": ["el", "en"],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "android": {
      "package": "gr.monadlabs.netprophet",
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": ["android.permission.SYSTEM_ALERT_WINDOW"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-image",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F2019",
          "image": "./assets/splash-logo.png",
          "imageWidth": 246.67
        }
      ],
      "expo-sharing",
      "expo-apple-authentication",
      "./plugins/withSceneLifecycle",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7136d3b3-4932-48d5-a8f6-64b527e13d2a"
      }
    },
    "owner": "evankardamitsis"
  }
}
