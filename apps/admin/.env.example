# Admin (apps/admin). Names only; real values live in Vercel and .env.local.
# v2 project (public)
NEXT_PUBLIC_V2_SUPABASE_URL=
NEXT_PUBLIC_V2_SUPABASE_PUBLISHABLE_KEY=
# Google service account key file (the whole JSON on one line); organisers share sheets with its email. Preferred.
GOOGLE_SERVICE_ACCOUNT_JSON=
# or: Google Sheets API v4 key, read by the scheduled sheet runs and «Δοκιμή τώρα» (the sheets are shared by link)
GOOGLE_SHEETS_API_KEY=
# v2 Supabase secret key (sb_secret_..., Project Settings > API Keys; not the legacy service_role JWT) for the
# scheduled run only; server-only, never NEXT_PUBLIC
V2_SUPABASE_SECRET_KEY=
# shared secret Vercel Cron sends as a Bearer token to /api/cron/*
CRON_SECRET=
